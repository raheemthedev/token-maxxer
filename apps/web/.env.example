# Copy to .env for local development. Every value below has a safe local default except where
# noted — the app runs with just the defaults, and clearly shows "sign-in not configured" until
# GitHub/email credentials are added.

# --- Database -----------------------------------------------------------------
# Postgres everywhere (Neon, via Vercel's marketplace integration in production). Point this at
# your own Postgres instance for local dev — e.g. a free Neon project, or the same database your
# Vercel deployment uses. Left empty, the app boots but every page shows "database not configured"
# instead of crashing.
DATABASE_URL=""

# --- Auth.js core ---------------------------------------------------------------
# Required in production; a dev fallback secret is used automatically when unset in development.
AUTH_SECRET=""

# --- GitHub OAuth (primary sign-in) ----------------------------------------------
# Create at https://github.com/settings/developers — Authorization callback URL:
#   http://localhost:3000/api/auth/callback/github   (dev)
#   https://<your-domain>/api/auth/callback/github   (prod)
# Only the default read:user scope is requested — never `repo`.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Email sign-in (magic link, alternative to GitHub) --------------------------
# When unset in development, magic links are logged to the server console instead of sent —
# clearly labeled, never silently dropped. Set these for real email delivery.
EMAIL_SERVER=""
EMAIL_FROM=""

# --- Collector pairing -----------------------------------------------------------
# HMAC key used to hash collector ingestion tokens at rest. A dev default is used automatically
# when unset in development; set a real random value in production.
COLLECTOR_TOKEN_SECRET=""
