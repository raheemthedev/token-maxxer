// Token Maxxer data model.
//
// Postgres (Neon, via Vercel's marketplace integration) everywhere — see docs/SETUP.md for
// pointing local dev at the same or a separate database.

generator client {
  provider = "prisma-client-js"
}

// Connection string lives in prisma.config.ts (Prisma 7 moved it out of schema files).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js / Auth.js schema, extended with `handle`)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  // Nullable at the DB level only because the OAuth adapter inserts the row before we can pick a
  // handle; `events.createUser` in src/auth.ts fills it in immediately afterward. Never nullable
  // in practice by the time a user can do anything.
  handle        String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  collectors      Collector[]
  projects        Project[]
  usageEvents     UsageEvent[]
  publishSettings PublishSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Collectors
// ---------------------------------------------------------------------------

// A paired local collector instance (one per machine/install, typically). Pairing authenticates
// the sender of ingested data; it does NOT prove the local records it reports are untampered —
// see docs/PRIVACY.md and the evidenceLevel field on UsageEvent.
model Collector {
  id              String    @id @default(cuid())
  userId          String
  name            String // e.g. hostname, user-editable
  tokenHash       String    @unique // sha256 of the long-lived ingestion token; the raw token is never stored
  projectSalt     String // per-user hashing pepper, handed back to every collector this user pairs
  status          String    @default("active") // active | revoked
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]

  @@index([userId])
}

// Short-lived one-time code shown in the dashboard and typed into the collector to pair it.
model PairingCode {
  code      String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id                String   @id @default(cuid())
  userId            String
  // Opaque id safe to expose publicly (equal to `id` today, kept distinct so we can rotate it
  // independently of the primary key later without a migration).
  opaqueId          String   @unique @default(cuid())
  // sha256 hash of the local path (git root or workspace folder), salted per-user. Never the raw
  // path. Used only to group usage events detected from the same local folder.
  fingerprintHash   String
  detectionMethod   String // session_metadata | git_root | workspace_folder
  // Raw local folder/repo name as detected. Local-context only: shown to the owning user in
  // their own dashboard, NEVER included in any public API response or page.
  detectedNameLocal String
  // User-approved public name. Required before a project can be made visible.
  displayName       String?
  visibility        String   @default("private") // private | public
  hidden            Boolean  @default(false)
  linkUrl           String?
  linkLabel         String? // repository | live | demo | release | video
  description       String?
  mergedIntoId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]

  @@unique([userId, fingerprintHash])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Usage
// ---------------------------------------------------------------------------

model UsageEvent {
  id               String   @id @default(cuid())
  userId           String
  collectorId      String?
  projectId        String?

  source           String // claude_code | opencode | synthetic
  sourceVersion    String?
  connectorVersion String?
  provider         String?
  model            String?

  // Stable id from the source, used together with collectorId for idempotent ingestion.
  sourceEventId    String
  eventType        String // incremental | cumulative_snapshot

  observedAt  DateTime
  periodStart DateTime?
  periodEnd   DateTime?

  // Mutually-exclusive accounting buckets. NULL means "unknown / not reported by this source",
  // never zero. See docs/ACCOUNTING.md for the headline-total rule computed from these.
  inputTokens               Int?
  outputTokens              Int?
  cacheReadTokens           Int?
  cacheWriteTokens          Int?
  reasoningTokens           Int?
  reasoningIncludedInOutput Boolean @default(false)

  attributionMethod String // session_metadata | git_root | workspace_folder | user_assigned | unassigned
  evidenceLevel     String // locally_reported | provider_verified

  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collector Collector? @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Idempotent ingestion: the same (collector, source event) can be POSTed again safely.
  @@unique([collectorId, sourceEventId])
  @@index([userId, observedAt])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Publishing
// ---------------------------------------------------------------------------

// Whether — and when — a user has explicitly approved appearing on the public leaderboard /
// profile at all. Per-project visibility is controlled separately on Project.visibility.
model PublishSettings {
  userId      String    @id
  isPublic    Boolean   @default(false)
  publishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
